# Local development + the extractor. Copy to `.env`. Never deployed —
# the production container reads `deploy/.env` instead (see docs/06-deployment.md).
# All relative paths resolve against the repo root.

# ---- backend (docs/04-backend.md) ----
# PORT=8080
# DATA_DIR=data
AUTH_MODE=anonymous
COMPANIES_FILE=data/companies.example.json
DEV_TODAY=2026-01-01
# STATIC_DIR=frontend/dist
# PUBLIC_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_ALLOWED_DOMAIN=

# ---- extractor (docs/03-extractor.md) ----
# Both are required for `npm run extract` (there is no keyless extraction — see D14;
# `npm run example-schedule` is the keyless path).
HARMONIC_API_KEY=
# HARMONIC_BASE_URL=https://api.harmonic.ai

# Exactly one of these three; the provider is inferred when only one is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
