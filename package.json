{
  "name": "venturedle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A daily startup-guessing game. One secret company per UTC day.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "extractor",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run typecheck && npm run build -w frontend",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "extract": "npm run extract -w extractor --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
