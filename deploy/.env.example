# What the production container and Caddy see. Copy to `deploy/.env`.
# No Harmonic or LLM keys here — production never calls either API.

# Hostname Caddy serves. ":80" = plain HTTP, no TLS (local / IP-only runs).
DOMAIN=:80

AUTH_MODE=anonymous
# GOOGLE_CLIENT_ID=
# GOOGLE_ALLOWED_DOMAIN=
# Appended as the last line of the share text.
# PUBLIC_URL=https://venturedle.example.com
